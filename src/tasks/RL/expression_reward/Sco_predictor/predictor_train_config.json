{
  "wandb_disabled": true,
  "model_name": "CODE/ProkBert",
  "data_csv": "datasets/Scoli/Scoli_165.csv",
  "label_col": "activity",
  "output_dir": "outputs/Scoli/Final",
  "split_dir": "outputs/Scoli/Final",
  "val_ratio": 0.1,
  "split_seed": 42,
  "freeze_encoder": true,
  "pooling": "mean_last4",
  "head_type": "cnn",
  "cnn_kernels": "3,5,7,11,15,21,35",
  "cnn_channels": 128,
  "cnn_pool": "maxmean",
  "head_hidden": 512,
  "head_dropout": 0.05,
  "batch_size": 8,
  "gradient_accumulation_steps": 4,
  "learning_rate": 0.0006,
  "num_train_epochs": 50,
  "warmup_ratio": 0.05,
  "weight_decay": 0.01,
  "loss_type": "huber",
  "huber_delta": 1.0,
  "max_length": 200,
  "pad_to_multiple_of": 8,
  "label_transform": "zscore",
  "early_stopping_patience": 8,
  "tokenizer_sanity_n": 3
}
